# Copy to .env and fill in.

# Required for TMDB matching (posters, canonical titles). Without it, matching is skipped.
TMDB_API_KEY=

# Catalog database and raw archive. Defaults are fine for local runs.
DB_PATH=./data/catalog.db
RAW_DIR=./data/raw

# Stores to refresh and CDON page window.
STORES=ax,cdon
MAX_PAGES_PER_CATEGORY=10
CRAWL_DELAY_SECONDS=2

# In-process daily refresh inside the web app. Leave false when using host cron.
RUN_SCHEDULER=false
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_INITIAL_DELAY_SECONDS=300

# Web app
API_HOST=0.0.0.0
API_PORT=8080
