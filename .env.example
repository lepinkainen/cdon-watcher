# Copy to .env and fill in.

# Required for TMDB matching (posters, canonical titles). Without it, matching is skipped.
TMDB_API_KEY=

# Catalog database and raw archive. Defaults are fine for local runs.
DB_PATH=./data/catalog.db
RAW_DIR=./data/raw

# moviecatalog (owned movies and the wishlist). Without it, browsing shows everything
# and there are no wishlist searches. Example: http://localhost:8080
MOVIECATALOG_URL=
# Most wishlist search requests per store in 24 hours.
SEARCH_DAILY_CAP=100
# Hours before a wish is searched again at the same store after a successful search.
SEARCH_MIN_INTERVAL_HOURS=24

# Stores to refresh and CDON page window.
STORES=ax,cdon,mymovies
MAX_PAGES_PER_CATEGORY=10
CRAWL_DELAY_SECONDS=2

# In-process daily refresh inside the web app. Leave false when using host cron.
RUN_SCHEDULER=false
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_INITIAL_DELAY_SECONDS=300

# Web app
API_HOST=0.0.0.0
API_PORT=8080
